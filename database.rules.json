{
  "rules": {
    ".read": false,
    ".write": false,

    "trips": {
      "$trip": {
        "votes": {
          ".read": true,

          "$voter": {
            ".write": true,
            ".validate": "$voter.length <= 40 && (!newData.exists() || newData.hasChildren(['name', 'picks']))",

            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
            },

            "picks": {
              ".validate": "newData.hasChildren()",
              "$i": {
                ".validate": "newData.isString() && newData.val().length <= 4 && newData.val().matches(/^[sf][0-9]{1,2}$/)"
              }
            },

            "updatedAt": {
              ".validate": "newData.isNumber()"
            },

            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
